{
    admin off
{% if config.get('auto_https_disable_redirects', True) %}
    auto_https disable_redirects
{% endif %}
}

:{{ config.get('listen_port', 80) }} {
{% if config.get('enable_gzip', True) %}
    encode gzip
{% endif %}

    @api path /api/* /health/* /docs* /openapi.json
    reverse_proxy @api {{ config.get('backend_upstream', 'backend:8000') }}

    reverse_proxy {{ config.get('frontend_upstream', 'frontend:4173') }}
}
