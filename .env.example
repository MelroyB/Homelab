# Core
COMPOSE_PROJECT_NAME=homelab
ENVIRONMENT=development
TZ=Europe/Amsterdam
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# API
API_PORT=8000
API_LOG_LEVEL=INFO
API_WORKERS=2
SECRET_KEY=change-me-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_COOKIE_SECURE=false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-dev-only
DOCKER_HOST=tcp://socket-proxy:2375

# Database
POSTGRES_DB=homelab
POSTGRES_USER=homelab
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+psycopg://homelab:change-me-db-password@postgres:5432/homelab

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
FRONTEND_PORT=4173
VITE_API_BASE_URL=/api/v1

# Mail stack
MAILSERVER_IMAGE=ghcr.io/docker-mailserver/docker-mailserver:latest
WEBMAIL_IMAGE=roundcube/roundcubemail:latest-apache
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail
MAIL_SMTP_PORT=25
MAIL_SUBMISSION_PORT=587
MAIL_IMAPS_PORT=993
WEBMAIL_HTTP_PORT=8081

# Backups
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_KEY=
